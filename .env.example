# Copy to .env and change for anything beyond local development.
WAREHOUSE_DB=warehouse
WAREHOUSE_PORT=5433
WAREHOUSE_ADMIN_USER=warehouse_admin
WAREHOUSE_ADMIN_PASSWORD=admin_dev_only
COPILOT_RO_PASSWORD=copilot_ro_dev_only

# LLM: the inference-gateway (github.com/pranavparuchur1/inference-gateway).
# Create a key there with `uv run igw keys create copilot`.
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=
LLM_MODEL=coder
